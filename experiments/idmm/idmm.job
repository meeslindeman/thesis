#!/bin/bash
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=idmm
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --time=23:59:00
#SBATCH --output=out/idmm/slurm_%A.out

set -eo pipefail

module purge
module load 2024
module load Anaconda3/2024.06-1

source activate hvit
# idmm before main so that train_idmm.py picks up the IDMM data_utils
export PYTHONPATH="$(pwd):$(pwd)/experiments/idmm:$(pwd)/experiments/main"
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

mkdir -p out/idmm

# -------------------------
# Dataset and model
# -------------------------
DATASET=flowers102     # flowers102 | dtd | aircrafts | cub200
MODEL=hyperbolic       # euclidean | hyperbolic

# -------------------------
# Architecture — DeiT-Tiny/16 as in the paper
# -------------------------
NUM_HIDDEN_LAYERS=12
HIDDEN_SIZE=192
NUM_ATTENTION_HEADS=3
MLP_DIM=768
PATCH_SIZE=16          # 112/16=7×7=49 tokens (pretrain), 224/16=14×14=196 tokens (finetune)

DATA_DIR=data/
VALIDATION_SIZE=0
CKPT_DIR="checkpoints/idmm/${DATASET}/${MODEL}"

# curvature is only a valid flag for hyperbolic
if [[ "$MODEL" == "hyperbolic" ]]; then
  CURVATURE_FLAG="--curvature 1.0"
else
  CURVATURE_FLAG=""
fi

# -------------------------
# Hyperparameters — match the paper exactly
# AdamW, lr=5e-4, wd=1e-3, cosine decay (no warmup), batch=256
# -------------------------
#LR=1.5e-4   # hyperbolic lr: 0.3 * paper's 5e-4, matching ratio from vit_hyperbolic/config.yml
LR=5e-4
WEIGHT_DECAY=1e-3
BATCH_SIZE=256
# Hyperbolic model uses more GPU memory; halve the finetune batch to avoid OOM at 224/448
if [[ "$MODEL" == "hyperbolic" ]]; then
  FINETUNE_BATCH_SIZE=128
  FINETUNE_BATCH_SIZE_HI=32   # 448px: 784 tokens, attention ~16x memory of 224px
else
  FINETUNE_BATCH_SIZE=256
  FINETUNE_BATCH_SIZE_HI=64
fi
SCHEDULER=warmup_cosine
if [[ "$MODEL" == "hyperbolic" ]]; then
  WARMUP_EPOCHS=10
else
  WARMUP_EPOCHS=2      # hardcoded in paper's train script
fi
LABEL_SMOOTHING=0.1    # paper sets epsilon=0.1

# -------------------------
# Stage 1: instance-discrimination pretraining
# Paper: 800 epochs at 112×112
# -------------------------
PRETRAIN_EPOCHS=800
PRETRAIN_IMAGE_SIZE=112

echo "=== Stage 1: pretrain ==="
echo "MODEL=${MODEL} DATASET=${DATASET} epochs=${PRETRAIN_EPOCHS} res=${PRETRAIN_IMAGE_SIZE} lr=${LR} batch=${BATCH_SIZE}"

srun python -u experiments/idmm/train_idmm.py \
  --stage pretrain \
  --model "${MODEL}" \
  --dataset "${DATASET}" \
  --data_dir "${DATA_DIR}" \
  --validation_size "${VALIDATION_SIZE}" \
  --epochs "${PRETRAIN_EPOCHS}" \
  --lr 1e-4 \
  --weight_decay "${WEIGHT_DECAY}" \
  --batch_size "${BATCH_SIZE}" \
  --scheduler "${SCHEDULER}" \
  --warmup_epochs "${WARMUP_EPOCHS}" \
  --label_smoothing "${LABEL_SMOOTHING}" \
  --num_hidden_layers "${NUM_HIDDEN_LAYERS}" \
  --hidden_size "${HIDDEN_SIZE}" \
  --num_attention_heads "${NUM_ATTENTION_HEADS}" \
  --mlp_dim "${MLP_DIM}" \
  --patch_size "${PATCH_SIZE}" \
  --pretrain_image_size "${PRETRAIN_IMAGE_SIZE}" \
  --use_cutmix \
  --n_global_crops 2 \
  --n_local_crops 4 \
  ${CURVATURE_FLAG} \
  --checkpoint_dir "${CKPT_DIR}"

# -------------------------
# Stage 2: supervised fine-tuning at 224×224
# Paper: 800 epochs
# -------------------------
FINETUNE_EPOCHS=800
PRETRAIN_CKPT="${CKPT_DIR}/idmm_pretrained_encoder.pt"

echo "=== Stage 2: finetune 224 ==="
echo "MODEL=${MODEL} DATASET=${DATASET} epochs=${FINETUNE_EPOCHS} res=224 lr=${LR} batch=${FINETUNE_BATCH_SIZE}"
# --lr "${LR}" \
srun python -u experiments/idmm/train_idmm.py \
  --stage finetune \
  --model "${MODEL}" \
  --dataset "${DATASET}" \
  --data_dir "${DATA_DIR}" \
  --validation_size "${VALIDATION_SIZE}" \
  --epochs "${FINETUNE_EPOCHS}" \
  --lr 2e-4 \
  --weight_decay "${WEIGHT_DECAY}" \
  --batch_size "${FINETUNE_BATCH_SIZE}" \
  --scheduler "${SCHEDULER}" \
  --warmup_epochs "${WARMUP_EPOCHS}" \
  --label_smoothing "${LABEL_SMOOTHING}" \
  --num_hidden_layers "${NUM_HIDDEN_LAYERS}" \
  --hidden_size "${HIDDEN_SIZE}" \
  --num_attention_heads "${NUM_ATTENTION_HEADS}" \
  --mlp_dim "${MLP_DIM}" \
  --patch_size "${PATCH_SIZE}" \
  --pretrain_image_size "${PRETRAIN_IMAGE_SIZE}" \
  ${CURVATURE_FLAG} \
  --pretrain_checkpoint "${PRETRAIN_CKPT}" \
  --save_every 50 \
  --checkpoint_dir "${CKPT_DIR}"

# -------------------------
# Stage 3: fine-tuning at 448×448
# Paper: 100 epochs, lr=5e-5, batch=128, starting from the 224 checkpoint
# -------------------------
FINETUNE_CKPT="${CKPT_DIR}/idmm_finetuned_${MODEL}.pt"

echo "=== Stage 3: finetune 448 ==="
echo "MODEL=${MODEL} DATASET=${DATASET} epochs=100 res=448 lr=5e-5 batch=${FINETUNE_BATCH_SIZE_HI}"

srun python -u experiments/idmm/train_idmm.py \
  --stage finetune \
  --model "${MODEL}" \
  --dataset "${DATASET}" \
  --data_dir "${DATA_DIR}" \
  --validation_size "${VALIDATION_SIZE}" \
  --epochs 100 \
  --lr 5e-5 \
  --weight_decay "${WEIGHT_DECAY}" \
  --batch_size "${FINETUNE_BATCH_SIZE_HI}" \
  --scheduler "${SCHEDULER}" \
  --warmup_epochs "${WARMUP_EPOCHS}" \
  --label_smoothing "${LABEL_SMOOTHING}" \
  --num_hidden_layers "${NUM_HIDDEN_LAYERS}" \
  --hidden_size "${HIDDEN_SIZE}" \
  --num_attention_heads "${NUM_ATTENTION_HEADS}" \
  --mlp_dim "${MLP_DIM}" \
  --patch_size "${PATCH_SIZE}" \
  --image_size 448 \
  ${CURVATURE_FLAG} \
  --pretrain_checkpoint "${FINETUNE_CKPT}" \
  --keep_classifier \
  --accum_steps 4 \
  --save_every 10 \
  --checkpoint_dir "${CKPT_DIR}"
